{
  "schemaVersion": 1,
  "scope": "Explicit local full-observer static commands. Workflow shell is not an argv source. Runtime suites, coverage artifacts, external checks, publication and deployment require separate evidence.",
  "sourceJobs": [
    "lint",
    "quality-gate",
    "quality-extended",
    "docs-sync-strict",
    "pr-test-policy",
    "i18n-ui-coverage",
    "i18n-glossary-zhcn"
  ],
  "exclusions": [
    {
      "alias": "check:pr-evidence",
      "reason": "Requires the pull request body; evaluated by hosted admission."
    },
    {
      "alias": "check:ai-attribution",
      "reason": "PR event metadata is evaluated by hosted admission; commit-message hooks remain active."
    },
    {
      "alias": "check:codeql-ratchet",
      "reason": "Reads remote CodeQL state and requires hosted security permissions."
    }
  ],
  "gates": [
    {
      "id": "check:test-tla-order",
      "job": "lint",
      "args": ["run", "check:test-tla-order"],
      "kind": "hard",
      "command": "node scripts/check/check-test-tla-order.mjs"
    },
    {
      "id": "check:node-runtime",
      "job": "lint",
      "args": ["run", "check:node-runtime"],
      "kind": "hard",
      "command": "node --import tsx scripts/check/check-supported-node-runtime.ts"
