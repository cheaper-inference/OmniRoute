# Real E2E homologation — copy to .env.homolog (NEVER commit the real one)
HOMOLOG_BASE_URL=http://192.168.0.15:20128
# VPS dashboard management password (same as /login)
HOMOLOG_ADMIN_PASSWORD=
# Leave empty: the suite creates an ephemeral API key via admin and revokes it at the end.

HOMOLOG_API_KEY=
# Critical tier (real chat, max_tokens=5). Other providers: catalog validation only.
HOMOLOG_CRITICAL_PROVIDERS=openai,anthropic,gemini,codex,grok,glm,deepseek,openrouter
