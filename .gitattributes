# Shell scripts must always be checked out with LF line endings.
#
# On Windows, core.autocrlf=true converts text files to CRLF in the working
# tree. Scripts that are kernel-exec'd (Docker ENTRYPOINT, bin/*.sh on Linux
# hosts) then fail with `exec ...: no such file or directory` because the
# shebang becomes "#!/bin/sh\r". eol=lf overrides autocrlf for these files.
*.sh text eol=lf

# This file must stay LF too: git parses it as-is, and a trailing CR would
# corrupt every pattern (e.g. "*.sh\r" matches nothing).
.gitattributes text eol=lf

# Generated files: GitHub collapses their diffs (linguist-generated) so a review shows the
# source change, not thousands of regenerated lines. Each one is rewritten by its generator
# in one refresh at release (release:refresh-derived) or a nightly refresh PR, never by a
# feature PR (plan 2026-11-13; config/quality/derived-paths/generated.json is the guard).
# The collapse is display-only: the file still diffs, merges and blames normally.
# Deliberately NOT marked: the generated skills/*/SKILL.md and the docs/i18n/*/llm.txt mirrors
# are agent-instruction surface (AGENTS.md → Review focus) whose diffs must stay visible.
docs/reference/PROVIDER_REFERENCE.md linguist-generated=true
docs/diagrams/readme-hero.svg linguist-generated=true
docs/diagrams/free-tier-budget.svg linguist-generated=true
docs/diagrams/works-zero-config.svg linguist-generated=true
docs/diagrams/promise-pillars.svg linguist-generated=true
docs/diagrams/why-pain-fix.svg linguist-generated=true
docs/diagrams/tier-cascade.svg linguist-generated=true
