PORT=8791
HEADLESS=true

# Egress must be US or Canada: muse.ai refuses other regions. Any HTTP proxy works.
PROXY_URL=http://USER:PASSWORD@HOST:PORT

# Muse account (muse.ai) and a mailbox the bridge can read the login OTP from
MUSE_EMAIL=account@example.com
TMAIL_EMAIL=account@example.com
TMAIL_PASSWORD=change-me

MODEL_ID=muse-agent
REPLY_TIMEOUT_MS=240000
REPLY_SETTLE_MS=3000
