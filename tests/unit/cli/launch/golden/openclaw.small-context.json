{
  "argv": [
    "tui",
    "--local"
  ],
  "cleanup": {
    "removeTempDir": true,
    "revokeSession": true
  },
  "env": {
    "set": {
      "DO_NOT_TRACK": "1",
      "OMNIROUTE_API_KEY": "${TOKEN}",
      "OPENCLAW_CONFIG_PATH": "${TMP}/openclaw.json",
      "OPENCLAW_NO_AUTO_UPDATE": "1",
      "OPENCLAW_STATE_DIR": "${TMP}/state",
      "XDG_CACHE_HOME": "${TMP}/cache"
    },
    "unset": [
      "OPENCLAW_AGENT_DIR",
      "OPENCLAW_HOME",
      "OPENCLAW_PROFILE",
      "OPENCLAW_WORKSPACE_DIR"
    ]
  },
  "modelList": {
    "injected": 1,
    "strategy": "inject",
    "viewHash": "f022f3fbdd54f7a6a1540ef56a2dd811d7425b05d1e40f9e5792c2d9f070994e"
  },
  "needsTempDir": true,
  "notes": [
    "All 1 view models are declared; switch in session with /model omniroute/<id>."
  ],
  "planVersion": 1,
  "postExitChecks": [],
  "preflight": [
    {
      "kind": "node-version",
      "range": ">=24.16.0 <25 || >=26.1.0",
      "why": "openclaw refuses other Node versions (node:sqlite NUL truncation) and may install a private Node under ~/.openclaw when run on an older one"
    }
  ],
  "secretSites": [
    {
      "key": "OMNIROUTE_API_KEY",
      "kind": "env"
    }
  ],
  "teardown": [],
  "tempFiles": [
    {
      "contents": "{\n  \"agents\": {\n    \"defaults\": {\n      \"model\": {\n        \"primary\": \"omniroute/small/ctx-6k\"\n      },\n      \"skipBootstrap\": true\n    }\n  },\n  \"discovery\": {\n    \"mdns\": {\n      \"mode\": \"off\"\n    }\n  },\n  \"models\": {\n    \"catalogRefresh\": {\n      \"enabled\": false\n    },\n    \"mode\": \"merge\",\n    \"providers\": {\n      \"omniroute\": {\n        \"api\": \"openai-completions\",\n        \"apiKey\": \"${OMNIROUTE_API_KEY:-omniroute-local}\",\n        \"baseUrl\": \"http://127.0.0.1:20128/v1\",\n        \"models\": [\n          {\n            \"contextWindow\": 6000,\n            \"id\": \"small/ctx-6k\",\n            \"input\": [\n              \"text\"\n            ],\n            \"maxTokens\": 8192,\n            \"name\": \"small/ctx-6k (OmniRoute)\"\n          }\n        ]\n      }\n    }\n  },\n  \"update\": {\n    \"checkOnStart\": false\n  }\n}\n",
      "format": "json",
      "mode": 384,
      "path": "openclaw.json"
    }
  ],
  "tool": "openclaw",
  "warnings": [
    "Model small/ctx-6k has a 6000-token context window; OpenClaw warns below 8000 and long sessions will compact often."
  ]
}
