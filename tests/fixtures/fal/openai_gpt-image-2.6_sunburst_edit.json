  "openapi": {
    "openapi": "3.1.0",
    "info": {
      "title": "Queue OpenAPI for fal-ai/gpt-image-2.6-sunburst/edit",
      "version": "1.0.0",
      "description": "The OpenAPI schema for the fal-ai/gpt-image-2.6-sunburst/edit queue.",
      "x-fal-metadata": {
        "endpointId": "fal-ai/gpt-image-2.6-sunburst/edit",
        "playgroundUrl": "https://fal.ai/models/fal-ai/gpt-image-2.6-sunburst/edit",
        "documentationUrl": "https://fal.ai/models/fal-ai/gpt-image-2.6-sunburst/edit/api",
        "about": "Edit images with the selected GPT Image 2.6 model."
      }
    },
    "components": {
      "securitySchemes": {
        "apiKeyAuth": {
          "type": "apiKey",
          "in": "header",
          "name": "Authorization",
          "description": "Fal Key"
        }
      },
      "schemas": {
        "QueueStatus": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": ["IN_QUEUE", "IN_PROGRESS", "COMPLETED"]
            },
            "request_id": {
              "type": "string",
              "description": "The request id."
            },
            "response_url": {
              "type": "string",
              "description": "The response url."
            },
            "status_url": {
              "type": "string",
              "description": "The status url."
            },
            "cancel_url": {
              "type": "string",
              "description": "The cancel url."
            },
            "logs": {
              "type": "object",
              "description": "The logs.",
              "additionalProperties": true
            },
            "metrics": {
              "type": "object",
              "description": "The metrics.",
              "additionalProperties": true
            },
            "queue_position": {
              "type": "integer",
              "description": "The queue position."
            }
          },
          "required": ["status", "request_id"]
        },
        "GptImage26SunburstEditInput": {
          "required": ["prompt", "image_urls"],
          "description": "GPT Image 2.6 edit inputs with model-specific quality and compression.",
          "x-fal-order-properties": [
            "prompt",
            "image_urls",
            "mask_url",
            "markup_image_url",
            "image_size",
            "background",
            "quality",
            "reasoning_effort",
            "num_images",
            "output_format",
            "output_compression",
            "frame_count",
            "frame_duration_ms",
            "sync_mode",
            "enable_safety_checker"
          ],
          "title": "GPTImage26EditImageRequest",
          "properties": {
            "frame_count": {
              "description": "GIF only: number of frames. image_size applies to each frame; reduce size or count if the request exceeds the pixel budget.",
              "default": 9,
              "maximum": 16,
              "minimum": 2,
              "title": "Frame Count",
              "type": "integer"
            },
            "output_compression": {
              "description": "Compression level from 0 to 100. Only supported when output_format is 'jpeg' or 'webp'.",
              "title": "Output Compression",
              "anyOf": [
                {
                  "maximum": 100,
                  "minimum": 0,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ]
            },
            "background": {
              "description": "Background for the generated image",
              "default": "auto",
              "title": "Background",
              "type": "string",
              "enum": ["auto", "transparent", "opaque"]
            },
            "image_size": {
              "description": "The size of the generated image. Use 'auto' to infer from input images.",
              "default": "auto",
              "title": "Image Size",
              "anyOf": [
                {
                  "$ref": "#/components/schemas/ImageSize"
                },
                {
                  "type": "string",
                  "enum": [
                    "square_hd",
                    "square",
                    "portrait_4_3",
                    "portrait_16_9",
                    "landscape_4_3",
                    "landscape_16_9",
                    "auto"
                  ]
                }
              ]
            },
            "markup_image_url": {
              "description": "Transparent PNG containing only annotations (circles, arrows, notes) that guide the edit of the first image. Must match the first image's dimensions. Cannot be combined with mask_url. Reference images are sent unmodified when set.",
              "title": "Markup Image URL",
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "sync_mode": {
              "description": "If `True`, the media will be returned as a data URI and the output data won't be available in the request history.",
              "default": false,
              "title": "Sync Mode",
              "type": "boolean"
            },
            "prompt": {
              "minLength": 1,
              "description": "The prompt for image generation",
              "examples": [
                "Same workers, same beam, same lunch boxes - but they're all on their phones now. One is taking a selfie. One is on a call looking annoyed. Same danger, new priorities. A hard hat has AirPods."
              ],
              "title": "Prompt",
              "maxLength": 32000,
              "type": "string"
            },
            "mask_url": {
              "description": "Mask image URL. White marks regions to edit and black marks regions to keep.",
              "title": "Mask URL",
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "image_urls": {
              "items": {
                "type": "string"
              },
              "description": "The URLs of the images to use as a reference for the generation. A maximum of 16 images are allowed.",
              "examples": [
                [
                  "https://v3b.fal.media/files/b/0a8691af/9Se_1_VX1wzTjjTOpWbs9_bb39c2eb-1a41-4749-b1d0-cf134abc8bbf.png"
                ]
              ],
              "maxItems": 16,
              "title": "Image URLs",
              "type": "array"
            },
            "quality": {
              "description": "Rendering quality for the generated image. For SVG output it controls the reference image used to create the vector.",
              "default": "high",
              "title": "Quality",
              "type": "string",
              "enum": ["auto", "low", "medium", "high", "xhigh", "max"]
            },
            "frame_duration_ms": {
              "description": "GIF only: milliseconds per frame, rounded to 10 ms.",
              "default": 200,
              "maximum": 2000,
              "minimum": 20,
              "title": "Frame Duration Ms",
              "type": "integer"
            },
            "reasoning_effort": {
              "description": "How much the model plans before rendering, independently of quality (OpenAI `complexity`). Higher levels can help with dense text and complex layouts but add latency.",
              "default": "high",
              "title": "Reasoning Effort",
              "type": "string",
              "enum": ["low", "medium", "high"]
            },
            "output_format": {
              "description": "Output format for the images. 'gif' returns an animation.",
              "default": "png",
              "title": "Output Format",
              "type": "string",
              "enum": ["jpeg", "png", "webp", "gif"]
            },
            "num_images": {
              "description": "Number of images to generate. Must be 1 for SVG output. For GIF output, all frames of all outputs share the request's pixel budget.",
              "default": 1,
              "maximum": 10,
              "minimum": 1,
              "title": "Number of Images",
              "type": "integer",
              "examples": [1]
            },
            "enable_safety_checker": {
              "description": "Authorized callers may set false to request relaxed screening.",
              "default": true,
              "title": "Enable Safety Checker",
              "type": "boolean"
            }
          },
          "type": "object"
        },
        "GptImage26SunburstEditOutput": {
          "required": ["images"],
          "x-fal-order-properties": ["images"],
          "title": "EditImageResponse",
          "properties": {
            "images": {
              "items": {
                "$ref": "#/components/schemas/ImageFile"
              },
              "description": "The generated images.",
              "examples": [
                [
                  {
                    "content_type": "image/png",
                    "height": 1024,
                    "url": "https://v3b.fal.media/files/b/0a8691b0/yUt7tifLSbg1WzWWgfj2o.png",
                    "file_name": "yUt7tifLSbg1WzWWgfj2o.png",
                    "width": 1024
                  }
                ]
              ],
              "title": "Images",
              "type": "array"
            }
          },
          "type": "object"
        },
        "ImageSize": {
          "x-fal-order-properties": ["width", "height"],
          "title": "ImageSize",
          "properties": {
            "height": {
              "description": "The height of the generated image.",
              "default": 512,
              "exclusiveMinimum": 0,
              "title": "Height",
              "maximum": 14142,
              "type": "integer"
            },
            "width": {
              "description": "The width of the generated image.",
              "default": 512,
              "exclusiveMinimum": 0,
              "title": "Width",
              "maximum": 14142,
              "type": "integer"
            }
          },
          "type": "object"
        },
        "ImageFile": {
          "required": ["url"],
          "x-fal-order-properties": [
            "url",
            "content_type",
            "file_name",
            "file_size",
            "width",
            "height"
          ],
          "title": "ImageFile",
          "properties": {
            "content_type": {
              "description": "The mime type of the file.",
              "examples": ["image/png"],
              "title": "Content Type",
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "height": {
              "description": "The height of the image",
              "title": "Height",
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ]
            },
            "url": {
              "description": "The URL where the file can be downloaded from.",
              "title": "Url",
              "type": "string"
            },
            "file_name": {
              "description": "The name of the file. It will be auto-generated if not provided.",
              "examples": ["z9RV14K95DvU.png"],
              "title": "File Name",
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "file_size": {
              "description": "The size of the file in bytes.",
              "examples": [4404019],
              "title": "File Size",
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ]
            },
            "width": {
              "description": "The width of the image",
              "title": "Width",
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "type": "object"
        }
      }
    },
    "paths": {
