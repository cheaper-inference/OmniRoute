{
  "endpoint_id": "fal-ai/demucs",
  "metadata": {
    "display_name": "Demucs",
    "category": "audio-to-audio",
    "description": "SOTA stemming model for voice, drums, bass, guitar and more.",
    "status": "active",
    "tags": ["audio"],
    "updated_at": "2026-04-21T17:44:58.841Z",
    "is_favorited": null,
    "thumbnail_url": "https://v3b.fal.media/files/b/tiger/WAcACXLL5-atiw1MGvH4g_7cb10ff246844b9c9298bbe98e431df7.jpg",
    "model_url": "https://fal.run/fal-ai/demucs",
