  "openapi": {
    "openapi": "3.1.0",
    "info": {
      "title": "Queue OpenAPI for fal-ai/gpt-image-2.5-flare",
      "version": "1.0.0",
      "description": "The OpenAPI schema for the fal-ai/gpt-image-2.5-flare queue.",
      "x-fal-metadata": {
        "endpointId": "fal-ai/gpt-image-2.5-flare",
        "playgroundUrl": "https://fal.ai/models/fal-ai/gpt-image-2.5-flare",
        "documentationUrl": "https://fal.ai/models/fal-ai/gpt-image-2.5-flare/api",
        "about": "Generate images with the selected GPT Image 2.5 model."
      }
    },
    "components": {
      "securitySchemes": {
        "apiKeyAuth": {
          "type": "apiKey",
          "in": "header",
          "name": "Authorization",
          "description": "Fal Key"
        }
      },
      "schemas": {
        "QueueStatus": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": ["IN_QUEUE", "IN_PROGRESS", "COMPLETED"]
            },
            "request_id": {
              "type": "string",
              "description": "The request id."
            },
            "response_url": {
              "type": "string",
              "description": "The response url."
            },
            "status_url": {
              "type": "string",
              "description": "The status url."
            },
            "cancel_url": {
              "type": "string",
              "description": "The cancel url."
            },
            "logs": {
              "type": "object",
              "description": "The logs.",
              "additionalProperties": true
            },
            "metrics": {
              "type": "object",
              "description": "The metrics.",
              "additionalProperties": true
            },
            "queue_position": {
              "type": "integer",
              "description": "The queue position."
            }
          },
          "required": ["status", "request_id"]
        },
        "GptImage25FlareInput": {
          "title": "GPTImage25TextToImageRequest",
          "description": "GPT Image 2.5 generation inputs, kept separate from GPT Image 2.",
          "required": ["prompt"],
          "type": "object",
          "properties": {
            "prompt": {
              "title": "Prompt",
              "minLength": 1,
              "maxLength": 32000,
              "examples": [
                "create a realistic image taken with iphone at these coordinates 41\u00b043\u203232\u2033N 49\u00b056\u203249\u2033W 15 April 1912"
              ],
              "description": "The prompt for image generation",
              "type": "string"
            },
            "sync_mode": {
              "title": "Sync Mode",
              "default": false,
              "description": "If `True`, the media will be returned as a data URI and the output data won't be available in the request history.",
              "type": "boolean"
            },
            "background": {
              "title": "Background",
              "default": "auto",
              "description": "Background for the generated image",
              "type": "string",
              "enum": ["auto", "transparent", "opaque"]
            },
            "image_size": {
              "title": "Image Size",
              "default": "landscape_4_3",
              "anyOf": [
                {
                  "$ref": "#/components/schemas/ImageSize"
                },
                {
                  "type": "string",
                  "enum": [
                    "square_hd",
                    "square",
                    "portrait_4_3",
                    "portrait_16_9",
                    "landscape_4_3",
                    "landscape_16_9",
                    "auto"
                  ]
                }
              ],
              "description": "The size of the generated image. Supports preset names, explicit {width, height}, or 'auto' to let the model pick the best size. Concrete sizes must have both dimensions as multiples of 16, max edge 3840px, aspect ratio <= 3:1, total pixels between 655,360 and 8,294,400."
            },
            "output_compression": {
              "title": "Output Compression",
              "description": "Compression level from 0 to 100. Only supported when output_format is 'jpeg' or 'webp'.",
              "anyOf": [
                {
                  "minimum": 0,
                  "type": "integer",
                  "maximum": 100
                },
                {
                  "type": "null"
                }
              ]
            },
            "quality": {
              "title": "Quality",
              "default": "high",
              "description": "Quality for the generated image. Higher settings increase detail, latency, and token usage. Use 'auto' to let the model choose.",
              "type": "string",
              "enum": ["auto", "low", "medium", "high", "xhigh", "max"]
            },
            "output_format": {
              "title": "Output Format",
              "default": "png",
              "description": "Output format for the images",
              "type": "string",
              "enum": ["jpeg", "png", "webp"]
            },
            "num_images": {
              "title": "Number of Images",
              "default": 1,
              "description": "Number of images to generate",
              "examples": [1],
              "minimum": 1,
              "type": "integer",
              "maximum": 10
            },
            "enable_safety_checker": {
              "title": "Enable Safety Checker",
              "default": true,
              "description": "Authorized callers may set false to request relaxed screening.",
              "type": "boolean"
            }
          },
          "x-fal-order-properties": [
            "prompt",
            "image_size",
            "background",
            "quality",
            "num_images",
            "output_format",
            "output_compression",
            "sync_mode",
            "enable_safety_checker"
          ]
        },
        "GptImage25FlareOutput": {
          "title": "ImageResponse",
          "required": ["images"],
          "type": "object",
          "properties": {
            "images": {
              "title": "Images",
              "description": "The generated images.",
              "examples": [
                [
                  {
                    "file_name": "EnWrO3XWjPE0nxBDpaQrj.png",
                    "height": 1024,
                    "url": "https://v3b.fal.media/files/b/0a869129/EnWrO3XWjPE0nxBDpaQrj.png",
                    "width": 1024,
                    "content_type": "image/png"
                  }
                ]
              ],
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/ImageFile"
              }
            }
          },
          "x-fal-order-properties": ["images"]
        },
        "ImageSize": {
          "title": "ImageSize",
          "type": "object",
          "properties": {
            "height": {
              "description": "The height of the generated image.",
              "exclusiveMinimum": 0,
              "title": "Height",
              "default": 512,
              "type": "integer",
              "maximum": 14142
            },
            "width": {
              "description": "The width of the generated image.",
              "exclusiveMinimum": 0,
              "title": "Width",
              "default": 512,
              "type": "integer",
              "maximum": 14142
            }
          },
          "x-fal-order-properties": ["width", "height"]
        },
        "ImageFile": {
          "title": "ImageFile",
          "required": ["url"],
          "type": "object",
          "properties": {
            "url": {
              "title": "Url",
              "description": "The URL where the file can be downloaded from.",
              "type": "string"
            },
            "height": {
              "title": "Height",
              "description": "The height of the image",
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ]
            },
            "file_size": {
              "title": "File Size",
              "description": "The size of the file in bytes.",
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "examples": [4404019]
            },
            "width": {
              "title": "Width",
              "description": "The width of the image",
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ]
            },
            "file_name": {
              "title": "File Name",
              "description": "The name of the file. It will be auto-generated if not provided.",
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "examples": ["z9RV14K95DvU.png"]
            },
            "content_type": {
              "title": "Content Type",
              "description": "The mime type of the file.",
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "examples": ["image/png"]
            }
          },
          "x-fal-order-properties": [
            "url",
            "content_type",
            "file_name",
            "file_size",
            "width",
            "height"
          ]
        }
      }
    },
    "paths": {
