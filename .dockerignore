# VCS
.git
**/.git

# Editor
.vscode
**/.vscode

# Dependencies and build output
# `node_modules` alone matches the ROOT only — Docker's matcher does not cross
# `/` like .gitignore does. Without the `**/` form, nested installs ship in the
# build context (e.g. @omniroute/opencode-provider/node_modules, ~79 MB of
# devDependencies). Both forms are kept: the bare one is the documented root
# rule, the `**/` one covers every nested package.
node_modules
**/node_modules
.next
.build
out
build
dist
coverage

# Runtime data and logs
data
logs
.sandbox

# Local env files (inject at runtime via --env-file or -e)
.env*
**/.env*
!.env.example

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Test suites
tests
test-results
playwright-report
blob-report
output
.playwright-cli
.playwright-mcp
.stryker-tmp
reports/mutation

# Local caches and quality-gate artifacts (all gitignored). `_*` does not match
# dot-prefixed names, so these need explicit entries.
.artifacts
.eslintcache*
.fakebin-*
MAX
quality-ratchet/

# Documentation
# Issue #2348: The Dashboard Docs viewer reads markdown from `/app/docs` at
# runtime. The previous `docs/*` block hid every file except openapi.yaml,
# so the in-product help screen failed with ENOENT for every page.
# We now keep the English markdown tree plus the docs assets imported by MDX
# during `next build`, while still dropping the extra raster diagram sources
# and the translated files the runtime never reads.
#
# 2026-11-03 (owner decision): the image serves the translated /docs pages
# (#18699), which read docs/i18n/<locale>/docs/<section>/<PAGE>.md at runtime.
# Re-include exactly those mirrors: the sections source.config.ts compiles,
# minus the operator-internal security pages re-excluded below. The README,
# CHANGELOG, agent-guide and llm.txt mirrors at each locale root stay out.
# Keep in sync with scripts/build/docsMirrorRuntime.mjs (enforced by
# tests/unit/docs-mirror-runtime-shipping.test.ts).
docs/i18n/**
!docs/i18n/*/docs/getting-started/**/*.md
!docs/i18n/*/docs/guides/**/*.md
!docs/i18n/*/docs/architecture/**/*.md
!docs/i18n/*/docs/reference/**/*.md
!docs/i18n/*/docs/frameworks/**/*.md
!docs/i18n/*/docs/routing/**/*.md
!docs/i18n/*/docs/security/**/*.md
!docs/i18n/*/docs/compression/**/*.md
!docs/i18n/*/docs/ops/**/*.md
!docs/i18n/*/docs/providers/**/*.md
!docs/i18n/*/docs/comparison/**/*.md
docs/i18n/*/docs/security/STEALTH_GUIDE.md
docs/i18n/*/docs/security/SOCKET_DEV_FINDINGS.md
docs/i18n/*/docs/security/MITM-TPROXY-DECRYPT.md
docs/i18n/*/docs/security/PUBLIC_CREDS.md
# Internal planning artifacts (gitignored). `*.md` above only matches the root,
# so without this rule these land in /app/docs and become readable through the
# dashboard's Docs viewer at runtime.
docs/superpowers/**
# Operator-internal security writeups: git only, not the image or /docs catalog.
docs/security/STEALTH_GUIDE.md
docs/security/SOCKET_DEV_FINDINGS.md
docs/security/MITM-TPROXY-DECRYPT.md
docs/security/PUBLIC_CREDS.md
docs/diagrams/**/*.png
docs/diagrams/**/*.jpg
docs/diagrams/**/*.jpeg
docs/diagrams/**/*.gif
docs/diagrams/**/*.webp
# Note: `*.md` matches the root only (Go filepath.Match does not cross /),
# so nested docs/**/*.md is implicitly kept without a re-include rule.
*.md
!README.md

