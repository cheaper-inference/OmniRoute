# Opt-in Docker Hardened Images (DHI) Node runtime for proxy-only deployments.
# Log in with `docker login dhi.io`, then build with a runner-base image:
# docker build -f Dockerfile.hardened --build-arg OMNIROUTE_IMAGE=<base-image> -t omniroute:hardened .
#
# DHI has no shell, npm, or libsecret. Provider CLIs are not bundled, and
# npm-based embedded service installs, local keychain reads via libsecret,
# and subprocesses that require sh (including child_process.exec()) fail.
# Update by rebuilding and redeploying from the host. The dashboard cannot
# update this image in place. Skipping check-permissions.sh also skips the
# data volume writability warning and runtime base-path patching.

ARG OMNIROUTE_IMAGE=ghcr.io/cheaper-inference/omniroute:next
FROM ${OMNIROUTE_IMAGE} AS app

FROM dhi.io/node:26.13.1-debian13@sha256:dee992f8941d9123721a20ca8260bcb31e9665f2583820735f6f7a9ab4fde9cb AS runner-hardened
WORKDIR /app
COPY --from=app --chown=1000:1000 /app /app

LABEL org.opencontainers.image.title="omniroute" \
  org.opencontainers.image.description="Unified AI proxy — hardened (DHI) runtime, proxy only" \
  org.opencontainers.image.url="https://omniroute.online" \
  org.opencontainers.image.source="https://github.com/cheaper-inference/OmniRoute" \
  org.opencontainers.image.licenses="MIT"

ENV NODE_ENV=production
ENV PORT=20128
ENV HOSTNAME=0.0.0.0
ENV OMNIROUTE_MEMORY_MB=1024
ENV NODE_OPTIONS="--max-old-space-size=${OMNIROUTE_MEMORY_MB}"
ENV DATA_DIR=/app/data
ENV REQUIRE_API_KEY=true
ENV OMNIROUTE_MIGRATIONS_DIR=/app/migrations

EXPOSE 20128
USER 1000:1000

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD ["node", "healthcheck.mjs"]

CMD ["node", "dev/run-standalone.mjs"]
