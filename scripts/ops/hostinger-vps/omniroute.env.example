# Install outside the repository at /etc/omniroute/omniroute.env, root:omniroute 0640.
# Generate unique secrets and a strong password before starting. Never use this
# template with empty secrets, and never commit the populated file.
NODE_ENV=production
DATA_DIR=/var/lib/omniroute
HOME=/var/lib/omniroute
OMNIROUTE_HOSTNAME=127.0.0.1
HOST=127.0.0.1
PORT=20128
JWT_SECRET=
API_KEY_SECRET=
STORAGE_ENCRYPTION_KEY=
INITIAL_PASSWORD=
REQUIRE_API_KEY=true
AUTH_COOKIE_SECURE=true
NEXT_PUBLIC_BASE_URL=https://fitoway.tech
OMNIROUTE_PUBLIC_BASE_URL=https://fitoway.tech
OMNIROUTE_TRUST_PROXY=loopback
OMNIROUTE_MEMORY_MB=4096
NEXT_TELEMETRY_DISABLED=1
LIVE_WS_PUBLIC_URL=wss://fitoway.tech/live-ws
LIVE_WS_ALLOWED_ORIGINS=https://fitoway.tech
LIVE_WS_HOST=127.0.0.1
ARENA_ELO_SYNC_ENABLED=false
